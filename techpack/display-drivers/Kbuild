# In-tree build (techpack/): what the external Android/Bazel build passed
# on the make command line. Exported -> reaches this techpack's subdirs only.
ifeq ($(KBUILD_EXTMOD),)
export DISPLAY_ROOT := $(abs_srctree)/$(src)
export MODNAME := msm_drm
export CONFIG_DRM_MSM := m
endif

