# In-tree build (techpack/): what the external Android/Bazel build passed
# on the make command line. Exported -> reaches this techpack's subdirs only.
ifeq ($(KBUILD_EXTMOD),)
export MMRM_ROOT := $(abs_srctree)/$(src)
endif


include $(MMRM_ROOT)/config/waipiommrm.conf
LINUXINCLUDE += -include $(MMRM_ROOT)/config/waipiommrmconf.h

ifneq ($(CONFIG_ARCH_QTI_VM), y)

obj-m += driver/
# obj-m += test/

ifeq ($(CONFIG_MSM_MMRM_VM),y)
LINUXINCLUDE += -I$(MMRM_ROOT)/vm/common/inc/
obj-m += vm/be/
endif

else

LINUXINCLUDE += -I$(MMRM_ROOT)/vm/common/inc/

obj-m += vm/fe/
obj-y += vm/fe/vm_test/

endif
