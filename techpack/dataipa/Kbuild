# In-tree build (techpack/). Trace headers default to a path relative to the
# old vendor/qcom/opensource location; point them at techpack/ instead.
subdir-ccflags-y += \
	-DGSI_TRACE_INCLUDE_PATH=../../techpack/dataipa/drivers/platform/msm/gsi \
	-DIPA_TRACE_INCLUDE_PATH=../../techpack/dataipa/drivers/platform/msm/ipa/ipa_v3 \
	-DRNDIS_TRACE_INCLUDE_PATH=../../techpack/dataipa/drivers/platform/msm/ipa/ipa_clients

subdir-ccflags-y += $(TP_INC_RMNET_MEM) $(TP_INC_RMNET_CORE)

obj-y += drivers/platform/msm/
