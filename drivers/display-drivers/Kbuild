# Display Drivers Kbuild
#
# This file is used when display-drivers is integrated into the kernel source tree
# at drivers/gpu/drm/msm/ or similar location.

ifeq ($(DISPLAY_ROOT),)
DISPLAY_ROOT=$(srctree)/drivers/gpu/drm/msm
endif

# Include paths for display drivers
LINUXINCLUDE    += \
		   -I$(DISPLAY_ROOT)/include/uapi/display \
		   -I$(DISPLAY_ROOT)/include \
		   -I$(DISPLAY_ROOT)/msm \
		   -I$(DISPLAY_ROOT)/msm/dp \
		   -I$(DISPLAY_ROOT)/msm/dsi \
		   -I$(DISPLAY_ROOT)/msm/sde \
		   -I$(DISPLAY_ROOT)/rotator

USERINCLUDE     += -I$(DISPLAY_ROOT)/include/uapi/display

# Compiler flags
ccflags-y += -DANI_LITTLE_BYTE_ENDIAN \
	     -DANI_LITTLE_BIT_ENDIAN \
	     -DDOT11F_LITTLE_ENDIAN_HOST \
	     -DANI_COMPILER_TYPE_GCC \
	     -DANI_OS_TYPE_ANDROID=6 \
	     -DPTT_SOCK_SVC_ENABLE \
	     -D__linux__

# Samsung display support
ccflags-$(CONFIG_DISPLAY_SAMSUNG) += -I$(DISPLAY_ROOT)/msm/samsung

# Main DRM MSM module
obj-$(CONFIG_DRM_MSM) += msm_drm.o

