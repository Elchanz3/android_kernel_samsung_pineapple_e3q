	bool "Samsung SecureDP Switch"
	depends on SECDP
	default n
	help
	  Enable Samsung SecureDP switch support.

config SECDP_DBG
	bool "Samsung SecureDP Debug"
	depends on SECDP
	default n
	help
	  Enable Samsung SecureDP debug features.

config SECDP_FACTORY_DPSWITCH_TEST
	bool "Samsung SecureDP Factory DP Switch Test"
	depends on SECDP
	default n
	help
	  Enable Samsung SecureDP factory DP switch test.

config DISPLAY_SAMSUNG
	bool "Samsung Display Support"
	default n
	help
	  Enable Samsung proprietary display driver support.

config PANEL_E3_S6E3HAE_AMB681AZ01_WQHD
	bool "Samsung E3 S6E3HAE AMB681AZ01 Panel (WQHD)"
	depends on DISPLAY_SAMSUNG
	default n
	help
	  Enable support for Samsung E3 S6E3HAE AMB681AZ01 WQHD panel.

config PANEL_E3_S6E3HAF_AMB679FN01_WQHD
	bool "Samsung E3 S6E3HAF AMB679FN01 Panel (WQHD)"
