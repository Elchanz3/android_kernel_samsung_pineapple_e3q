config SAMSUNG_DEBUG_DISPLAY
	bool "Samsung Display Debug"
	depends on DISPLAY_SAMSUNG
	default n
	help
	  Enable Samsung display debugging features.

config DUAL_PANEL
	bool "Dual Panel Support"
	depends on DISPLAY_SAMSUNG
	default n
	help
	  Enable dual panel operation support.

config PARTIAL_UPDATE
	bool "Partial Update Support"
	depends on DISPLAY_SAMSUNG
	default n
	help
	  Enable partial display update support.

config CABC_FUNCTION
	bool "Content Adaptive Backlight Control (CABC)"
	depends on DISPLAY_SAMSUNG
	default n
	help
	  Enable CABC functionality.

config SUPPORT_POC_FLASH
	bool "POC Flash Support"
	depends on DISPLAY_SAMSUNG
	default n
	help
	  Enable POC (Panel Operation Code) flash support.

config OPCODE_PARSER
	bool "Opcode Parser"
	default n
	help
	  Enable opcode parser support.

config PANEL_KUNIT
	bool "Panel KUnit Tests"
	depends on DISPLAY_SAMSUNG && SEC_KUNIT
	default n
	help
	  Enable KUnit tests for panel drivers.

source "drivers/gpu/drm/msm/Kconfig"
